			"name": "factoryondatafactory_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureBlobLocationCloud_connectionString": {
						"value": "[parameters('AzureBlobLocationCloud_connectionString')]"
					},
					"CopyFunctionLinkedService_functionKey": {
						"value": "[parameters('CopyFunctionLinkedService_functionKey')]"
					},
					"LocalServer_password": {
						"value": "[parameters('LocalServer_password')]"
					},
					"AzureFunctionRestService_properties_typeProperties_url": {
						"value": "[parameters('AzureFunctionRestService_properties_typeProperties_url')]"
					},
					"CopyFunctionLinkedService_properties_typeProperties_functionAppUrl": {
						"value": "[parameters('CopyFunctionLinkedService_properties_typeProperties_functionAppUrl')]"
					},
					"LocalServer_properties_typeProperties_host": {
						"value": "[parameters('LocalServer_properties_typeProperties_host')]"
					},
					"LocalServer_properties_typeProperties_userId": {
						"value": "[parameters('LocalServer_properties_typeProperties_userId')]"
					}
