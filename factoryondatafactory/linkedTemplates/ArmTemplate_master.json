		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "factoryondatafactory"
		},
		"AzureBlobLocationCloud_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureBlobLocationCloud'"
		},
		"CopyFunctionLinkedService_functionKey": {
			"type": "secureString",
			"metadata": "Secure string for 'functionKey' of 'CopyFunctionLinkedService'"
		},
		"LocalServer_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LocalServer'"
		},
		"AzureFunctionRestService_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://datafactoryfunctionapp-hegvhpa4d4fzfbht.southafricanorth-01.azurewebsites.net/api/UploadFile?code=vaj5S-Y-NEiJDTGuoCiF3bbxhqKzhd2arWGdUkzK0DMDAzFu2c8NWg=="
		},
		"CopyFunctionLinkedService_properties_typeProperties_functionAppUrl": {
			"type": "string",
			"defaultValue": ""
		},
		"LocalServer_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "C:\\DFTest"
		},
		"LocalServer_properties_typeProperties_userId": {
			"type": "string",
			"defaultValue": "ENTELECT\\jeanjacques.byleveld"
